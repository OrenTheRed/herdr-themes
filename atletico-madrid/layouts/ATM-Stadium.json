{
  "id": "atletico-madrid-stadium-root",
  "type": "column",
  "titlebar": "none",
  "theme": "ATM",
  "preview": "layouts/ATM-Stadium.svg",
  "traffic_lights": [
    12,
    16
  ],
  "font_size": 13,
  "ui_font": "Geist",
  "background": "#10142E",
  "colors": {
    "accent": "#E03A3E",
    "border": "#272E61"
  },
  "terminal_padding": [
    10,
    12
  ],
  "resizable": false,
  "children": [
    {
      "id": "stadium-field",
      "type": "block",
      "size": {
        "weight": 0.85
      },
      "content": {
        "mod": "atletico-madrid-stadium"
      }
    },
    {
      "id": "stadium-rail",
      "type": "block",
      "size": {
        "px": 44
      },
      "content": {
        "mod": "atletico-madrid-stadium",
        "props": {
          "role": "rail"
        }
      }
    },
    {
      "id": "stadium-bench",
      "type": "block",
      "size": {
        "weight": 1
      },
      "padding": [
        0,
        10
      ],
      "background": "#10142E",
      "content": {
        "tab": "active",
        "pane": {
          "gap": 10,
          "radius": 4,
          "lone": true,
          "background": "#10142E",
          "border": {
            "width": 3,
            "color": "#272E61"
          },
          "focus": {
            "width": 3,
            "color": "#E03A3E"
          },
          "header": {
            "content": {
              "mod": "atletico-madrid-stadium",
              "props": {
                "role": "pane"
              }
            },
            "height": 28,
            "position": "top",
            "reveal": "always"
          }
        }
      }
    }
  ]
}
